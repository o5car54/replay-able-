# Copy this file to ".env" and fill in your values.
# With no Twilio keys the app runs in SIMULATION mode (texts are logged, not sent) — great for testing.

# --- Server ---
PORT=3000
# Protect the dashboard with a password. Leave blank for an open dashboard (local dev only).
ADMIN_PASSWORD=

# --- Twilio (leave blank to stay in simulation mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public URL of this server once hosted (used only in the dashboard's setup instructions)
BASE_URL=
